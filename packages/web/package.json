{
  "name": "@volute/web",
  "version": "0.0.1",
  "description": "Standalone Volute web UI — connect to any Volute daemon",
  "type": "module",
  "bin": {
    "volute-web": "./dist/serve.js"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "dev": "vite dev"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@volute/api": "*",
    "@volute/ui": "*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "dompurify": "3.4.16",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
