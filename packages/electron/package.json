{
  "name": "@volute/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "npm run download-node && tsc && electron-builder",
    "pack": "npm run download-node && tsc && electron-builder --dir",
    "download-node": "tsx scripts/download-node.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
