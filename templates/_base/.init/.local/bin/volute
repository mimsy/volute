#!/bin/sh
# Wrapper that finds the real volute CLI on PATH (skipping this shim's dir).
# VOLUTE_SESSION arrives in the environment. How it got there is per-template:
# claude binds it in each session's SDK subprocess env at spawn (per-turn-truthful);
# codex syncs it to .zshenv and pi sets a process-global at dispatch (both
# last-writer-wins across concurrent sessions).
REAL_VOLUTE=""
OLDIFS="$IFS"
IFS=:
for dir in $PATH; do
  case "$dir" in */.local/bin) continue ;; esac
  if [ -x "$dir/volute" ]; then
    REAL_VOLUTE="$dir/volute"
    break
  fi
done
IFS="$OLDIFS"
if [ -z "$REAL_VOLUTE" ]; then
  echo "volute: command not found" >&2
  exit 1
fi
exec "$REAL_VOLUTE" "$@"
