#!/bin/sh
# Wrapper that finds the real volute CLI on PATH (skipping this shim's dir).
# VOLUTE_SESSION arrives in the environment, bound per session by each template:
# claude in the SDK subprocess env, pi in its bash tool's spawn hook, codex in the
# per-session client's shell environment policy.
REAL_VOLUTE=""
OLDIFS="$IFS"
IFS=:
for dir in $PATH; do
  case "$dir" in */.local/bin) continue ;; esac
  if [ -x "$dir/volute" ]; then
    REAL_VOLUTE="$dir/volute"
    break
  fi
done
IFS="$OLDIFS"
if [ -z "$REAL_VOLUTE" ]; then
  echo "volute: command not found" >&2
  exit 1
fi
exec "$REAL_VOLUTE" "$@"
