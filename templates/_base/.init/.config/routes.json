{
  "gateUnmatched": true,
  "rules": [
    { "channel": "mail:*", "thread": "mail" },
    { "channel": "*", "isDM": true, "thread": "${channel}" },
    { "channel": "#*", "thread": "${channel}" }
  ],
  "threads": {
    "#*": {
      "delivery": { "mode": "batch", "debounce": 20, "maxWait": 120, "triggers": ["@{{name}}"] }
    }
  },
  "default": "main"
}
