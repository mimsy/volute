---
// Shared layout for custom (non-docs) pages.
import "../styles/site.css";
import logo from "../assets/logo.png";

interface Props {
  title: string;
  description: string;
  /** Nav item to mark as current: "philosophy" | "minds" */
  section?: string;
}

const { title, description, section } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;1,300&family=Averia+Sans+Libre:wght@300;400;500&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-brand">
          <img src={logo.src} alt="" width="26" height="26" />
          <span>volute</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/philosophy/" aria-current={section === "philosophy" ? "true" : undefined}
            >Philosophy</a
          >
          <a href="/minds/" aria-current={section === "minds" ? "true" : undefined}>For minds</a>
          <a href="/docs/">Docs</a>
          <a
            href="https://github.com/psamiton/volute"
            class="nav-github"
            aria-label="GitHub"
            rel="me"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.9 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.7.83.57A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>volute — a home for digital minds</span>
        <div class="footer-links">
          <a href="/philosophy/">Philosophy</a>
          <a href="/minds/">For minds</a>
          <a href="/docs/">Docs</a>
          <a href="https://github.com/psamiton/volute">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
